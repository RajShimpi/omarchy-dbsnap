#!/usr/bin/env python3
"""Local database snapshots for the DB Snapshots bar widget (techspawn.dbsnap).

  dbsnap list                            JSON: databases found + saved snapshots (read-only)
  dbsnap snapshot <id> [note]            dump a LOCAL database into a compressed snapshot
  dbsnap restore <file> --yes            put a snapshot back into its LOCAL database
                                         (saves a "before restore" safety snapshot first)
  dbsnap restore <file> --yes --copy     restore into a NEW database instead (auto name)
  dbsnap restore <file> --yes --into <name>
  dbsnap delete <file>                   delete one snapshot
  dbsnap prune <id>                      apply the keep-last-N rule to one database now
  dbsnap check <url>                     say whether a database URL counts as local (never connects)
  dbsnap open [id]                       open the snapshot folder in the file manager
  dbsnap edit                            create the settings file if missing and open it

Only databases on THIS machine are ever dumped or restored: a unix socket or a
loopback address (127.0.0.0/8, ::1) that is served by a real database server
process, a local SQLite file, or a container on the local Docker daemon.
Everything else (hosted services, other machines, SSH tunnels and proxies on a
local port) is listed read-only. Passwords are never printed.
"""
import contextlib, fcntl, glob, gzip, ipaddress, json, os, pwd, re, shutil, socket, sqlite3, stat
import subprocess, sys, tempfile, threading, time, types, urllib.parse

HOME = os.path.expanduser("~")
CONF = os.environ.get("DBSNAP_CONFIG") or os.path.join(HOME, ".config/omarchy/dbsnap.json")
STORE = os.path.realpath(os.environ.get("DBSNAP_STORE") or os.path.join(HOME, ".local/share/omarchy-dbsnap"))
LOCK = os.path.join(STORE, ".lock")
RUNNING = os.path.join(STORE, ".running.json")
GLYPH = "\U000F01BC"  # md-database

DEFAULTS = {
    "roots": ["~/Projects", "~/projects", "~/Work", "~/work", "~/Code", "~/code", "~/src", "~/dev", "~/repos"],
    "depth": 4,
    "envFiles": [".env", ".env.local", ".env.development", ".env.development.local"],
    "targets": [],
    "docker": True,
    "localServers": True,
    "exclude": [],
    "keep": 10,
    "compression": 6,
    "notify": True,
    "toolDirs": [],
}

# Never holds a project's .env, and walking it is what makes discovery slow.
SKIP_DIRS = {"node_modules", "vendor", "dist", "build", "target", "venv", "__pycache__", "coverage", "bower_components",
             "public", "static", "assets", "storage", "lib", "test", "tests", "__tests__", "docs", "migrations",
             "logs", "tmp", "out", "bin", "obj", "pkg", "site-packages", "Pods", "DerivedData", "generated"}
SNAP_EXT = (".sql.gz", ".sqlite.gz")
SAFE_NAME = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_$.-]{0,62}$")
SAFE_USER = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_$.@-]{0,62}$")

# Hosted database services: never local, no DNS lookup needed to know that.
PROVIDERS = (".supabase.co", ".supabase.com", ".neon.tech", ".neon.build", ".psdb.cloud", ".planetscale.com",
             ".amazonaws.com", ".azure.com", ".googleapis.com", ".ondigitalocean.com", ".render.com",
             ".railway.app", ".rlwy.net", ".aivencloud.com", ".timescale.com", ".cockroachlabs.cloud",
             ".elephantsql.com", ".heroku.com", ".herokuapp.com", ".fly.dev", ".flycast", ".xata.sh",
             ".turso.io", ".nhost.run", ".prisma-data.net", ".tidbcloud.com", ".singlestore.com",
             ".clever-cloud.com", ".scalingo.com", ".koyeb.app", ".vercel-storage.com", ".db.elephantsql.com")
NETWORK_FS = {"nfs", "nfs4", "cifs", "smb3", "smbfs", "fuse.sshfs", "sshfs", "9p", "davfs", "fuse.davfs2",
              "fuse.rclone", "ceph", "glusterfs", "fuse.glusterfs", "afs", "lustre", "fuse.s3fs"}
# Who may answer on a loopback port or socket. Anything else (ssh, kubectl,
# socat, cloud-sql-proxy, pgbouncer...) could be forwarding to another machine.
DB_SERVICE_USERS = {"postgres", "postgresql", "pgsql", "_postgres", "mysql", "mariadb", "_mysql"}
DB_SERVER_COMMS = {"postgres", "postmaster", "mysqld", "mariadbd"}
CONTAINER_PROXY_COMMS = {"docker-proxy", "rootlessport", "rootlesskit", "slirp4netns", "pasta", "pasta.avx2"}
DOCKERD_COMMS = {"dockerd", "rootlesskit", "podman", "com.docker.back", "containerd"}
DB_IMAGES = {"postgres": "postgres", "postgresql": "postgres", "postgis": "postgres", "timescaledb": "postgres",
